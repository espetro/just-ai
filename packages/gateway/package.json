    "ofetch": "^1.5.1",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.1"
  }
